APP_NAME=EDUFILE
APP_ENV=local
APP_KEY=base64:HPdA8Tyid6PQLkUg2bYOakWEi5QtwVB0KSD30sUnVA0=
APP_DEBUG=true
APP_URL=http://udh.localhost:8010
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=universite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Universités ───────────────────────────────────────────────
# Domaine des sous-domaines universités (local : localhost)
UNIVERSITES_DOMAINE=localhost
UNIVERSITE_DEFAUT=udh
# ?uni=xxx pour changer d'université : local uniquement
UNIVERSITES_PARAMETRE_UNI=true
# Noms des bases en local (en production : edufile_<code> par défaut)
UNI_UDH_DB=gesnotes
UNI_UAM_DB=gesnotes_uam
UNI_UDO_DB=gesnotes_udo
UNI_UDA_DB=gesnotes_uda
UNI_UDDM_DB=gesnotes_uddm
UNI_UAS_DB=gesnotes_uas
UNI_UBB_DB=gesnotes_ubb
UNI_UAZ_DB=gesnotes_uaz
UNI_UIM_DB=gesnotes_uim

# ── Licence ───────────────────────────────────────────────────
# Clé de signature des licences. Doit être IDENTIQUE à celle de l'ancienne
# application tant que les deux tournent, sinon les licences émises
# deviennent invalides. (Voir anomalie A7 de l'inventaire : à changer.)
LICENCE_SECRET=CHANGEZ_CETTE_CLE_AVANT_LA_PREMIERE_UTILISATION_XyZ29

# ── Dossiers de fichiers de l'ancienne application ────────────
# Photos, logos… restent pour l'instant dans l'ancienne application.
ANCIENNE_APP_CHEMIN=C:/xampp00/htdocs/gesnotes
# Sauvegardes SQL (défaut : storage/app/private/sauvegardes, un sous-dossier par université)
# DOSSIER_SAUVEGARDES=
# Base propre aux comptes et au journal des espaces Ministère et ANAB (gesnotes:separer-espaces)
# ESPACES_BASE=gesnotes_espaces
# Sans ESPACES_BASE : université dont la base contient ces comptes (défaut : udh)
# ESPACES_UNIVERSITE_COMPTES=udh
# Compte MySQL en lecture seule des espaces Ministère / ANAB (gesnotes:compte-lecture-espaces) — vide : compte principal
# ESPACES_DB_USERNAME=
# ESPACES_DB_PASSWORD=
# Clé des QR codes de vérification (défaut : APP_KEY) — ne jamais la changer après impression de documents
# VERIFICATION_SECRET=
# Mot de passe de protection des exports Excel du PV (vide : aléatoire, le fichier ne peut pas être déprotégé)
# PV_EXCEL_MOT_DE_PASSE=
# Images du carrousel du portail candidats (<dossier>/<sigle>/slide-N.jpg)
# DOSSIER_IMAGES_PORTAIL=

# Pages non migrées : ouvertes dans l'ancienne application
ANCIENNE_APP_URL=http://{code}.localhost
INACTIVITE_MINUTES=30

# Paiement en ligne KomiPay (portail candidats) — à renseigner, jamais à versionner
KOMIPAY_ENV=sandbox
KOMIPAY_LOGIN=
KOMIPAY_PASSWORD=
KOMIPAY_API_KEY=
KOMIPAY_KEYPASS=
KOMIPAY_MOYENS=mynita,amana

# Sauvegardes automatiques (BASCULE.md § 6) — journal binaire MySQL requis pour différentielles et incrémentielles
SAUVEGARDES_AUTO=false
# SAUVEGARDES_AUTO_DOSSIER=
# SAUVEGARDES_AUTO_OUTILS=C:\xampp00\mysql\bin
SAUVEGARDES_AUTO_DB_USERNAME=
SAUVEGARDES_AUTO_DB_PASSWORD=
# SAUVEGARDES_AUTO_GARDER=5
# SAUVEGARDES_AUTO_GARDER_MOIS=12
SAUVEGARDES_AUTO_ALERTE=
# Copie hors du serveur après chaque sauvegarde (rclone, remote chiffré « crypt » sur Google Drive)
SAUVEGARDES_HORS_SERVEUR_RCLONE=
SAUVEGARDES_HORS_SERVEUR_CONFIG=
SAUVEGARDES_HORS_SERVEUR_DESTINATION=
